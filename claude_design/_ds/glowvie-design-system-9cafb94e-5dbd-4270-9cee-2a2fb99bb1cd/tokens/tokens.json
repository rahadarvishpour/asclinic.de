{
  "color": {
    "g-coral": "#E8836A",
    "g-coral-600": "#D96A4C",
    "g-coral-700": "#B85433",
    "g-coral-100": "#FBE4DC",
    "g-blush": "#F9D8CE",
    "g-blush-50": "#FDF1EC",
    "g-cream": "#FDF8F5",
    "g-stone": "#EFEDEA",
    "g-lemon": "#F3F1D9",
    "g-line": "#E8E1DB",
    "g-charcoal": "#1F1D1C",
    "g-charcoal-900": "#151413",
    "g-ink": "#16110F",
    "g-ink-2": "#6E6763",
    "g-ink-3": "#9A928C",
    "g-white": "#FFFFFF",
    "g-sage": "#5F7059",
    "g-gold": "#B98A2E",
    "bg": "var(--g-cream)",
    "bg-soft": "var(--g-blush-50)",
    "bg-quiet": "var(--g-stone)",
    "bg-blush": "var(--g-blush)",
    "bg-invert": "var(--g-charcoal)",
    "surface": "var(--g-white)",
    "text": "var(--g-ink)",
    "text-muted": "var(--g-ink-2)",
    "text-faint": "var(--g-ink-3)",
    "text-invert": "#F6F1ED",
    "accent": "var(--g-coral)",
    "accent-action": "var(--g-coral-700)",
    "accent-hover": "var(--g-charcoal)",
    "border": "var(--g-line)",
    "focus": "#7A3B21"
  },
  "type": {
    "font-display": "\"Playfair Display\", \"Prata\", Georgia, \"Times New Roman\", serif",
    "font-body": "\"DM Sans\", \"Jost\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
    "fs-display": "clamp(2.5rem, 1.4rem + 4.4vw, 4.25rem)",
    "fs-h1": "clamp(2.125rem, 1.4rem + 2.9vw, 3.25rem)",
    "fs-h2": "clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem)",
    "fs-h3": "clamp(1.3rem, 1.1rem + 0.9vw, 1.625rem)",
    "fs-h4": "1.125rem",
    "fs-lead": "1.0625rem",
    "fs-body": "1rem",
    "fs-sm": "0.875rem",
    "fs-xs": "0.75rem",
    "fs-2xs": "0.6875rem",
    "fw-display": "500",
    "lh-tight": "1.1",
    "lh-heading": "1.22",
    "lh-body": "1.7",
    "ls-display": "-0.015em",
    "ls-eyebrow": "0.2em",
    "ls-nav": "0.12em",
    "ls-button": "0.1em"
  },
  "space": {
    "sp-1": "0.25rem",
    "sp-2": "0.5rem",
    "sp-3": "0.75rem",
    "sp-4": "1rem",
    "sp-5": "1.5rem",
    "sp-6": "2rem",
    "sp-7": "3rem",
    "sp-8": "4rem",
    "sp-9": "6rem",
    "sp-10": "8rem",
    "section-y": "clamp(3.5rem, 2rem + 6.5vw, 7rem)",
    "gutter": "clamp(1.25rem, 0.5rem + 3vw, 3rem)",
    "maxw": "1240px",
    "measure": "60ch"
  },
  "radius": {
    "r-sm": "6px",
    "r-md": "12px",
    "r-lg": "20px",
    "r-image": "16px",
    "r-arch": "260px 260px var(--r-image) var(--r-image)",
    "r-blob": "58% 42% 46% 54% / 52% 48% 52% 48%",
    "r-pill": "999px"
  },
  "shadow": {
    "sh-1": "0 1px 2px rgba(22,17,15,.04), 0 4px 14px rgba(22,17,15,.05)",
    "sh-2": "0 6px 18px rgba(22,17,15,.07), 0 18px 40px rgba(22,17,15,.07)",
    "sh-3": "0 16px 34px rgba(22,17,15,.10), 0 40px 80px rgba(22,17,15,.12)",
    "sh-focus": "0 0 0 3px var(--g-cream), 0 0 0 5px var(--focus)"
  },
  "motion": {
    "ease-out": "cubic-bezier(.22, 1, .36, 1)",
    "ease-soft": "cubic-bezier(.4, 0, .2, 1)",
    "ease-back": "cubic-bezier(.34, 1.4, .64, 1)",
    "dur-fast": "180ms",
    "dur-base": "320ms",
    "dur-slow": "620ms",
    "dur-reveal": "800ms",
    "stagger": "90ms",
    "float-dur": "7s",
    "marquee-dur": "34s"
  }
}