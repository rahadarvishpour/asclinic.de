{
  "color": {
    "g-cream": "#FDFAF6",
    "g-sand": "#F5EBE1",
    "g-clay": "#E7D6C7",
    "g-line": "#E2D3C5",
    "g-rose-soft": "#F3DFD7",
    "g-rose": "#A85B45",
    "g-rose-hover": "#8E4A37",
    "g-rose-light": "#C97B63",
    "g-espresso": "#2B1E19",
    "g-ink": "#241C18",
    "g-ink-2": "#574B43",
    "g-ink-3": "#8A7C72",
    "g-sage": "#5F7059",
    "g-sage-soft": "#E4EADF",
    "g-gold": "#B98A2E",
    "g-white": "#FFFFFF",
    "bg": "var(--g-cream)",
    "bg-alt": "var(--g-sand)",
    "bg-invert": "var(--g-espresso)",
    "surface": "var(--g-white)",
    "text": "var(--g-ink)",
    "text-muted": "var(--g-ink-2)",
    "text-faint": "var(--g-ink-3)",
    "text-invert": "#F6EFE8",
    "accent": "var(--g-rose)",
    "accent-hover": "var(--g-rose-hover)",
    "border": "var(--g-line)",
    "focus": "#7A4132"
  },
  "type": {
    "font-display": "\"Marcellus\", \"Playfair Display\", Georgia, \"Times New Roman\", serif",
    "font-body": "\"Jost\", \"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
    "fs-display": "clamp(2.75rem, 1.6rem + 4.6vw, 4.5rem)",
    "fs-h1": "clamp(2.25rem, 1.5rem + 3vw,   3.5rem)",
    "fs-h2": "clamp(1.75rem, 1.3rem + 1.9vw, 2.75rem)",
    "fs-h3": "clamp(1.375rem, 1.15rem + 1vw, 1.75rem)",
    "fs-h4": "1.25rem",
    "fs-lead": "1.125rem",
    "fs-body": "1rem",
    "fs-sm": "0.875rem",
    "fs-xs": "0.75rem",
    "lh-tight": "1.08",
    "lh-heading": "1.18",
    "lh-body": "1.65",
    "ls-display": "-0.01em",
    "ls-eyebrow": "0.22em",
    "ls-button": "0.06em"
  },
  "space": {
    "sp-1": "0.25rem",
    "sp-2": "0.5rem",
    "sp-3": "0.75rem",
    "sp-4": "1rem",
    "sp-5": "1.5rem",
    "sp-6": "2rem",
    "sp-7": "3rem",
    "sp-8": "4rem",
    "sp-9": "6rem",
    "sp-10": "8rem",
    "section-y": "clamp(3.5rem, 2rem + 7vw, 7.5rem)",
    "gutter": "clamp(1.25rem, 0.5rem + 3vw, 3rem)",
    "maxw": "1240px",
    "measure": "62ch"
  },
  "radius": {
    "r-sm": "8px",
    "r-md": "16px",
    "r-lg": "24px",
    "r-xl": "40px",
    "r-image": "28px",
    "r-arch": "999px 999px var(--r-image) var(--r-image)",
    "r-pill": "999px"
  },
  "shadow": {
    "sh-1": "0 1px 2px rgba(36,28,24,.05), 0 2px 8px rgba(36,28,24,.04)",
    "sh-2": "0 4px 12px rgba(36,28,24,.06), 0 12px 32px rgba(36,28,24,.07)",
    "sh-3": "0 12px 28px rgba(36,28,24,.09), 0 32px 64px rgba(36,28,24,.10)",
    "sh-focus": "0 0 0 3px var(--g-cream), 0 0 0 5px var(--focus)"
  },
  "motion": {
    "ease-out": "cubic-bezier(.22, 1, .36, 1)",
    "ease-soft": "cubic-bezier(.4, 0, .2, 1)",
    "dur-fast": "160ms",
    "dur-base": "240ms",
    "dur-slow": "480ms"
  }
}