---
// AURA // Aesthetic Lab — Landingpage (deutsch)
const treatments = [
  { name: 'Laser-Resurfacing', desc: 'Fraktionierte CO₂-Therapie für Textur, Narben & Hautbild.', duration: '45 Min.', vid: 'https://assets.mixkit.co/videos/52153/52153-360.mp4' },
  { name: 'Hydrafacial-Ritual', desc: 'Tiefenreinigung, Peeling & Antioxidantien-Infusion.', duration: '60 Min.', vid: 'https://assets.mixkit.co/videos/52159/52159-360.mp4' },
  { name: 'Medizinische Hautpflege', desc: 'Medizinische Seren, individuell zusammengestellt.', duration: '30 Min.', img: 'https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?q=80&w=800&auto=format&fit=crop' },
  { name: 'Body Contouring', desc: 'Nicht-invasives Sculpting mit klinischer Überwachung.', duration: '75 Min.', img: 'https://images.unsplash.com/photo-1629909613654-28e377c37b09?q=80&w=800&auto=format&fit=crop' },
];
const pillars = [
  { num: '01', title: 'Medizinische Präzision', body: 'CE-zertifizierte Geräte, ärztlich geführte Protokolle, dokumentierte Ergebnisse.' },
  { num: '02', title: 'Maßgeschneiderte Pläne', body: 'Diagnostische Hautanalyse vor jeder Behandlungsempfehlung.' },
  { num: '03', title: 'Ganzheitliche Nachsorge', body: '12-monatiges Nachsorgeprogramm mit persönlicher Betreuung.' },
];
const testimonials = [
  { initials: 'SM', name: 'Sophie M.', treatment: 'Hydrafacial', quote: 'Allein die Beratung war es wert — man hat mir gesagt, was ich nicht brauche. Seltene Ehrlichkeit, wunderschöne Ergebnisse.' },
  { initials: 'LK', name: 'Lena K.', treatment: 'Laser-Resurfacing', quote: 'Drei Sitzungen und meine Aknenarben sind kaum noch sichtbar. Dr. Voss hat mir jeden Schritt genau erklärt.' },
  { initials: 'AT', name: 'Amir T.', treatment: 'Body Contouring', quote: 'Diskret, professionell, kein Druck. Das Nachsorgeprogramm hebt AURA von allen anderen ab.' },
];
---
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AURA // Aesthetic Lab — Ästhetische Klinik Berlin</title>
  <meta name="description" content="Wissenschaftlich fundierte ästhetische Behandlungen in Berlin: Laser-Resurfacing, Hydrafacial, Body Contouring, Haartransplantation." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<div class="hero-wrap" id="hero-wrap">
  <canvas id="aura-particles"></canvas>
  <nav>
    <div class="logo">AURA <span class="logo-sep">//</span> <span class="logo-sub">Aesthetic Lab</span></div>
    <div class="nav-links">
      <a href="#treatments">Behandlungen</a><a href="#philosophy">Philosophie</a><a href="#results">Ergebnisse</a><a href="#specialists">Spezialisten</a><a href="#faq">FAQ</a>
    </div>
    <a href="#book" class="btn btn-accent">Beratung buchen</a>
  </nav>
  <header>
    <div class="hero-copy">
      <div class="badge-glass">★ 4,9/5 bewertet von über 1.200 Kunden in Berlin</div>
      <h1>Wissenschaftlich fundierte Schönheit.<br /><em class="grad">Auf höchstem Niveau.</em></h1>
      <p>Medizinisch-ästhetische Behandlungen mit höchster Präzision — maßgeschneiderte Pläne, zertifizierte Spezialisten, sichtbare Ergebnisse.</p>
      <div class="cta-row">
        <a href="#treatments" class="btn btn-accent btn-lg">Behandlungen entdecken</a>
        <a href="#experience" class="btn btn-outline btn-lg"><span class="play">▶</span> Erlebnis ansehen</a>
      </div>
      <div class="hero-stats">
        <div><div class="stat-num">12.000+</div><div class="stat-label">Behandlungen</div></div>
        <div><div class="stat-num">14</div><div class="stat-label">Jahre Erfahrung</div></div>
        <div><div class="stat-num">98&nbsp;%</div><div class="stat-label">Zufriedenheit</div></div>
      </div>
    </div>
    <div class="hero-media">
      <video src="https://assets.mixkit.co/videos/52152/52152-360.mp4" autoplay muted loop playsinline></video>
      <div class="float-card">
        <div class="float-label">Nächster Termin</div>
        <div class="float-value">Heute · 16:30 Uhr</div>
      </div>
    </div>
  </header>
</div>

<div class="marquee"><div class="marquee-track">
  <span>Botox &amp; Filler &nbsp;•&nbsp; <i class="outline">Laser-Resurfacing</i> &nbsp;•&nbsp; Hydrafacial &nbsp;•&nbsp; <i class="outline">Hautverjüngung</i> &nbsp;•&nbsp; Body Contouring &nbsp;•&nbsp; <i class="outline">Haartransplantation</i> &nbsp;•&nbsp;</span>
  <span>Botox &amp; Filler &nbsp;•&nbsp; <i class="outline">Laser-Resurfacing</i> &nbsp;•&nbsp; Hydrafacial &nbsp;•&nbsp; <i class="outline">Hautverjüngung</i> &nbsp;•&nbsp; Body Contouring &nbsp;•&nbsp; <i class="outline">Haartransplantation</i> &nbsp;•&nbsp;</span>
</div></div>

<section id="hair-journey" class="container hair">
  <div class="hair-copy reveal"><span class="ghost">01</span>
    <div class="kicker">Haartransplantation</div>
    <h2>Vom ersten Graft zur <em>vollen Dichte.</em></h2>
    <p class="lead">Sapphire-FUE-Haartransplantation — einzelne Follikel, unter Vergrößerung präzise gesetzt. Bewegen Sie den Cursor über das Porträt und sehen Sie zwölf Monate Haarwachstum.</p>
    <div class="milestones">
      <div class="milestone" data-m="1"><div class="m-num">0</div><div><strong>Monat 0 — Entnahme &amp; Implantation</strong><span>Sapphire-Klingen-FUE unter lokaler Betäubung. Keine lineare Narbe.</span></div></div>
      <div class="milestone" data-m="2"><div class="m-num">4</div><div><strong>Monat 4 — Aktives Wachstum</strong><span>Neue Follikel verankern sich und treten in die Wachstumsphase ein.</span></div></div>
      <div class="milestone" data-m="3"><div class="m-num">12</div><div><strong>Monat 12 — Volle Dichte</strong><span>Natürlicher Haaransatz, dauerhaftes Ergebnis, stylbar nach Wunsch.</span></div></div>
    </div>
  </div>
  <div class="hair-media reveal d1">
    <div class="ba-slider" id="hair-slider">
      <img src="/assets/hair-before.png" alt="Vor der Haartransplantation" />
      <div class="ba-after" id="hair-after">
        <img src="/assets/hair-after.png" alt="Nach der Haartransplantation, volles Haar" />
        <div class="tag tag-light">Nachher · Monat 12</div>
      </div>
      <div class="tag tag-dark">Vorher · Monat 0</div>
      <div class="ba-divider" id="hair-divider"><div class="ba-handle">⇔</div></div>
    </div>
    <div class="density-card">
      <div class="density-head"><span>Follikeldichte</span><span id="hair-pct">50%</span></div>
      <div class="density-bar"><div id="hair-fill"></div></div>
    </div>
  </div>
</section>

<section id="treatments" class="container">
  <div class="section-head reveal"><span class="ghost g2">02</span>
    <h2>Signature-<br /><em>Behandlungen</em></h2>
    <p>Vier Kerndisziplinen — jede von einem eigenen Spezialisten geleitet und auf die Biologie Ihrer Haut abgestimmt.</p>
  </div>
  <div class="cards reveal d1">
    {treatments.map((t) => (
      <div class="card">
        {t.vid ? <video data-src={t.vid} autoplay muted loop playsinline></video> : <div class="card-img" style={`background-image:url('${t.img}')`}></div>}
        <div class="card-grad"></div>
        <div class="tag tag-dark card-dur">{t.duration}</div>
        <div class="card-body">
          <div class="card-title">{t.name}</div>
          <div class="card-desc">{t.desc}</div>
          <div class="card-link">Details ansehen <span>→</span></div>
        </div>
      </div>
    ))}
  </div>
</section>

<section id="results" class="container results"><div class="reveal">
  <h2>Echte Ergebnisse, <em>ungefilterte Präzision.</em></h2>
  <p class="sub">Ziehen Sie den Regler zum Vergleichen. Unretuschierte klinische Fotografie.</p>
  <div class="ba-slider results-slider" id="results-slider">
    <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=1200&auto=format&fit=crop" alt="Nach der Behandlung" />
    <div class="ba-after" id="results-after">
      <img class="before-filter" src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?q=80&w=1200&auto=format&fit=crop" alt="Vor der Behandlung" />
      <div class="tag tag-dark">Vorher</div>
    </div>
    <div class="tag tag-light tag-right">Nachher</div>
    <div class="ba-divider" id="results-divider"><div class="ba-handle">⇔</div></div>
    <input type="range" min="0" max="100" value="50" id="results-range" aria-label="Vorher-Nachher-Vergleich" />
  </div>
</div>
</section>

<section id="philosophy" class="surface-band">
  <div id="experience" class="container philosophy">
    <img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?q=80&w=1200&auto=format&fit=crop" alt="Klinik-Interieur" />
    <div>
      <div class="kicker">Das Klinik-Erlebnis</div>
      <h2>Ein ruhiges, klinisches Refugium im Herzen Berlins.</h2>
      <p class="lead">Jedes Detail unseres Studios — von der Luftfilterung bis zur Lichttemperatur — ist auf Sicherheit, Komfort und ehrliche Beratung ausgelegt. Kein Aufschwatzen. Kein Druck. Nur Evidenz.</p>
      <div class="pillars">
        {pillars.map((p) => (
          <div class="pillar"><div class="p-num">{p.num}</div><div><strong>{p.title}</strong><span>{p.body}</span></div></div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="specialists" class="container">
  <h2 class="center tight">Von Kunden empfohlen. <em>Von Medizin geführt.</em></h2>
  <p class="center-sub">Jede Bewertung stammt aus einer verifizierten Behandlung in unserer Klinik.</p>
  <div class="trust-chips">
    <div class="chip"><span class="chip-star">★ 4,9</span> Google Bewertungen</div>
    <div class="chip">1.200+ verifizierte Kunden</div>
    <div class="chip">98&nbsp;% Weiterempfehlung</div>
    <div class="chip">Mitglied DGÄM</div>
  </div>
  <div class="testimonials reveal">
    {testimonials.map((tm) => (
      <div class="t-card">
        <div class="stars">★★★★★</div>
        <p>{tm.quote}</p>
        <div class="t-foot">
          <div class="t-avatar">{tm.initials}</div>
          <div><strong>{tm.name}</strong><span>✓ Verifizierter Kunde · {tm.treatment}</span></div>
        </div>
      </div>
    ))}
  </div>
  <div class="doctor reveal d1">
    <div class="doc-photo"><img src="https://images.unsplash.com/photo-1519823551278-64ac92734fb1?q=80&w=400&auto=format&fit=crop" alt="Dr. Elena Voss" /></div>
    <div class="doc-info">
      <div class="kicker">Leitende Dermatologin</div>
      <div class="doc-name">Dr. Elena Voss, MD</div>
      <p>Fachärztin für Dermatologie · 14 Jahre klinische Praxis · Absolventin der Charité Berlin · Mitglied der Deutschen Gesellschaft für Ästhetische Medizin (DGÄM). Jeder Behandlungsplan bei AURA wird persönlich geprüft und freigegeben.</p>
    </div>
    <div class="doc-sig"><div class="sig">E. Voss</div><div class="sig-label">Ärztliche Leitung</div><a href="#book" class="btn btn-dark">Termin bei Dr. Voss</a></div>
  </div>
</section>

<section id="book" class="footer-cta">
  <div class="container footer-grid">
    <div>
      <div class="hours"><span class="dot"></span> Heute geöffnet bis 19 Uhr</div>
      <h2>Ihre Haut verdient eine <em>Beratung</em>, kein Verkaufsgespräch.</h2>
      <p class="lead">30-minütige kostenlose Erstberatung mit einem Spezialisten. Hautanalyse inklusive. Unverbindlich.</p>
      <div class="contact">
        <div>Kurfürstendamm 184 · 10707 Berlin</div>
        <div><a href="tel:+493012345678">+49 30 1234 5678</a> · <a href="mailto:hello@asclinic.de">hello@asclinic.de</a></div>
      </div>
    </div>
    <form class="booking" onsubmit="return false">
      <div class="booking-title">Beratung buchen</div>
      <input placeholder="Vollständiger Name" />
      <input placeholder="E-Mail oder Telefon" />
      <select>
        <option>Gewünschte Behandlung…</option>
        <option>Botox &amp; Filler</option>
        <option>Laser-Resurfacing</option>
        <option>Hydrafacial</option>
        <option>Body Contouring</option>
        <option>Haartransplantation</option>
      </select>
      <button class="btn btn-accent btn-lg" type="submit">Termin anfragen</button>
      <div class="fine">Wir antworten innerhalb von 2 Geschäftsstunden.</div>
    </form>
  </div>
  <div class="container footer-bar">
    <div class="f-logo">AURA // Aesthetic Lab</div>
    <div class="f-links"><a href="#treatments">Behandlungen</a><a href="#results">Ergebnisse</a><a href="#specialists">Spezialisten</a><a href="#faq">Impressum</a></div>
    <div>© 2026 AURA Aesthetic Lab Berlin</div>
  </div>
</section>

<style is:global>
  :root { --bg:#FBF9F5; --surface:#fff; --border:#E5E0D8; --ink:#1C1917; --accent:#E8D5C8; --deep:#c9a68f; --deep2:#a58b76; --graphite:#45484e; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--graphite); color:var(--ink); font-family:'Plus Jakarta Sans',sans-serif; -webkit-font-smoothing:antialiased; }
  a { color:inherit; text-decoration:none; }
  h1,h2 { font-family:'Cormorant Garamond',serif; font-weight:500; margin:0; }
  h2 { font-size:clamp(36px,4vw,48px); line-height:1.1; margin-bottom:20px; }
  em { font-weight:400; }
  ::selection { background:var(--accent); }
  .container { max-width:1400px; margin:0 auto; padding:96px 48px; }
  .kicker { font-size:12px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:var(--deep2); margin-bottom:16px; }
  .lead { font-size:15px; line-height:1.75; color:#57534E; max-width:460px; margin:0 0 40px; }
  .btn { display:inline-flex; align-items:center; gap:10px; border-radius:999px; padding:12px 24px; font-size:14px; font-weight:600; transition:all .25s ease; }
  .btn:hover { transform:translateY(-2px); box-shadow:0 12px 28px rgba(0,0,0,.3); }
  .btn-accent { background:var(--accent); color:var(--ink); border:none; cursor:pointer; }
  .btn-outline { border:1px solid rgba(245,244,242,.35); color:#F5F4F2; }
  .btn-lg { padding:16px 32px; font-size:15px; }
  .play { display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:50%; background:var(--accent); color:var(--ink); font-size:9px; }
  .tag { position:absolute; font-size:12px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; padding:6px 14px; border-radius:999px; backdrop-filter:blur(6px); }
  .tag-dark { top:20px; left:20px; background:rgba(28,25,23,.6); color:#fff; }
  .tag-light { top:20px; right:20px; background:rgba(255,255,255,.85); color:var(--ink); }
  .tag-right { left:auto; right:20px; }
  /* hero */
  .hero-wrap { position:relative; background:var(--graphite); color:#F5F4F2; }
  #aura-particles { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
  nav { position:sticky; top:0; z-index:50; display:flex; align-items:center; justify-content:space-between; padding:16px 48px; background:rgba(63,66,72,.72); backdrop-filter:blur(16px); border-bottom:1px solid rgba(255,255,255,.12); }
  .logo { font-family:'Cormorant Garamond',serif; font-size:24px; font-weight:600; }
  .logo-sep { color:var(--accent); font-weight:400; } .logo-sub { font-weight:400; font-style:italic; }
  .nav-links { display:flex; gap:32px; font-size:14px; font-weight:500; }
  .nav-links a { color:rgba(245,244,242,.75); } .nav-links a:hover { color:#fff; }
  header { position:relative; display:flex; align-items:center; gap:64px; padding:72px 48px 88px; max-width:1400px; margin:0 auto; }
  .hero-copy { flex:1.05; min-width:0; }
  .badge-glass { display:inline-flex; gap:8px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.18); border-radius:999px; padding:8px 18px; font-size:13px; font-weight:500; color:rgba(245,244,242,.85); margin-bottom:32px; backdrop-filter:blur(8px); }
  h1 { font-size:clamp(48px,6vw,88px); line-height:1.02; margin-bottom:28px; color:#F5F4F2; }
  h1 em { color:var(--accent); }
  .hero-copy p { font-size:17px; line-height:1.7; color:rgba(245,244,242,.7); max-width:480px; margin:0 0 40px; }
  .cta-row { display:flex; gap:16px; align-items:center; }
  .hero-media { flex:1; min-width:0; position:relative; }
  .hero-media video { width:100%; height:560px; object-fit:cover; border-radius:32px; display:block; box-shadow:0 24px 64px rgba(0,0,0,.3); background:#1C1917; }
  .float-card { position:absolute; bottom:28px; left:-36px; background:rgba(255,255,255,.85); backdrop-filter:blur(12px); border:1px solid var(--border); border-radius:20px; padding:18px 22px; box-shadow:0 12px 32px rgba(0,0,0,.2); animation:floaty 5s ease-in-out infinite; }
  .float-label { font-size:12px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--deep2); margin-bottom:4px; }
  .float-value { font-family:'Cormorant Garamond',serif; font-size:22px; font-weight:600; }
  @keyframes floaty { 0%,100% { transform:translateY(0);} 50% { transform:translateY(-10px);} }
  /* marquee */
  .marquee { border-top:1px solid var(--border); border-bottom:1px solid var(--border); background:var(--surface); overflow:hidden; padding:18px 0; }
  .marquee-track { display:flex; width:max-content; animation:marquee 24s linear infinite; font-family:'Cormorant Garamond',serif; font-size:20px; letter-spacing:.14em; text-transform:uppercase; color:#78716C; white-space:nowrap; }
  .marquee-track span { padding-right:48px; }
  @keyframes marquee { from { transform:translateX(0);} to { transform:translateX(-50%);} }
  /* hair */
  .hair { display:grid; grid-template-columns:1fr 1.05fr; gap:72px; align-items:center; }
  .milestones { display:flex; flex-direction:column; gap:18px; }
  .milestone { display:flex; gap:16px; align-items:flex-start; opacity:.35; transition:opacity .4s ease; }
  .milestone.active { opacity:1; }
  .milestone strong { display:block; font-size:15px; } .milestone span { font-size:13px; color:#78716C; line-height:1.6; }
  .m-num { width:36px; height:36px; border-radius:50%; background:var(--accent); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; flex-shrink:0; }
  .hair-media { position:relative; }
  .ba-slider { position:relative; border-radius:28px; overflow:hidden; box-shadow:0 24px 64px rgba(28,25,23,.14); height:600px; cursor:ew-resize; user-select:none; }
  .ba-slider > img, .ba-after img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .ba-after { position:absolute; inset:0; clip-path:inset(0 0 0 50%); }
  .ba-divider { position:absolute; top:0; bottom:0; left:50%; width:2px; background:#fff; box-shadow:0 0 12px rgba(0,0,0,.3); }
  .ba-handle { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:40px; height:40px; border-radius:50%; background:#fff; box-shadow:0 4px 16px rgba(28,25,23,.3); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; color:var(--ink); }
  .density-card { position:absolute; bottom:-28px; left:32px; right:32px; background:rgba(255,255,255,.88); backdrop-filter:blur(12px); border:1px solid var(--border); border-radius:18px; padding:16px 22px; box-shadow:0 12px 32px rgba(28,25,23,.12); }
  .density-head { display:flex; justify-content:space-between; font-size:12px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--deep2); margin-bottom:8px; }
  .density-bar { height:6px; border-radius:999px; background:var(--border); overflow:hidden; }
  #hair-fill { height:100%; width:50%; border-radius:999px; background:linear-gradient(90deg,var(--accent),var(--deep)); }
  /* treatments */
  .section-head { display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:48px; gap:24px; }
  .section-head p { font-size:15px; color:#78716C; max-width:340px; margin:0; line-height:1.6; }
  .cards { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
  .card { position:relative; border-radius:24px; overflow:hidden; height:420px; cursor:pointer; background:#1C1917; transition:transform .3s ease, box-shadow .3s ease; }
  .card:hover { transform:translateY(-6px); box-shadow:0 20px 48px rgba(28,25,23,.22); }
  .card:hover .card-link span { transform:translateX(4px); }
  .card video, .card-img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.92; background-size:cover; background-position:center; }
  .card-grad { position:absolute; inset:0; background:linear-gradient(to top, rgba(28,25,23,.85) 0%, rgba(28,25,23,.15) 55%, transparent 100%); }
  .card-dur { left:auto; right:16px; top:16px; }
  .card-body { position:absolute; bottom:0; left:0; right:0; padding:24px; color:#FBF9F5; }
  .card-title { font-family:'Cormorant Garamond',serif; font-size:26px; font-weight:600; margin-bottom:6px; }
  .card-desc { font-size:13px; color:rgba(251,249,245,.75); line-height:1.5; margin-bottom:14px; }
  .card-link { display:inline-flex; align-items:center; gap:8px; font-size:13px; font-weight:600; color:var(--accent); }
  .card-link span { display:inline-block; transition:transform .25s ease; }
  /* results */
  .results { text-align:center; }
  .results .sub { font-size:15px; color:#78716C; margin:0 0 48px; }
  .results-slider { max-width:920px; margin:0 auto; height:520px; text-align:left; }
  .before-filter { filter:grayscale(.85) brightness(.92) contrast(.95); }
  #results-after { clip-path:inset(0 50% 0 0); }
  #results-range { position:absolute; inset:0; width:100%; height:100%; opacity:0; cursor:ew-resize; margin:0; }
  /* philosophy */
  .surface-band { background:var(--surface); border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
  .philosophy { display:grid; grid-template-columns:1.1fr 1fr; gap:72px; align-items:center; }
  .philosophy > img { width:100%; height:620px; object-fit:cover; border-radius:28px; display:block; box-shadow:0 20px 56px rgba(28,25,23,.12); }
  .pillars { display:flex; flex-direction:column; gap:24px; }
  .pillar { display:flex; gap:18px; align-items:flex-start; padding:20px 22px; background:var(--bg); border:1px solid var(--border); border-radius:18px; }
  .pillar strong { display:block; font-size:16px; margin-bottom:4px; } .pillar span { font-size:14px; color:#78716C; line-height:1.6; }
  .p-num { width:38px; height:38px; border-radius:50%; background:var(--accent); display:flex; align-items:center; justify-content:center; font-family:'Cormorant Garamond',serif; font-size:17px; font-weight:600; flex-shrink:0; }
  /* specialists */
  .center { text-align:center; margin-bottom:48px; }
  .testimonials { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-bottom:24px; }
  .t-card { background:var(--surface); border:1px solid var(--border); border-radius:22px; padding:28px; display:flex; flex-direction:column; gap:16px; box-shadow:0 6px 20px rgba(28,25,23,.04); }
  .stars { color:var(--deep); letter-spacing:3px; font-size:14px; }
  .t-card p { font-size:15px; line-height:1.7; color:#44403C; margin:0; flex:1; }
  .t-foot { display:flex; align-items:center; gap:12px; }
  .t-avatar { width:42px; height:42px; border-radius:50%; background:linear-gradient(135deg,var(--accent),#d3b8a5); display:flex; align-items:center; justify-content:center; font-family:'Cormorant Garamond',serif; font-weight:600; }
  .t-foot strong { display:block; font-size:14px; } .t-foot span { font-size:12px; color:var(--deep2); font-weight:500; }
  .doctor { background:var(--surface); border:1px solid var(--border); border-radius:26px; padding:40px 44px; display:flex; align-items:center; gap:40px; box-shadow:0 10px 32px rgba(28,25,23,.06); }
  .doc-photo { width:120px; height:120px; border-radius:50%; overflow:hidden; flex-shrink:0; border:3px solid var(--accent); }
  .doc-photo img { width:100%; height:100%; object-fit:cover; }
  .doc-info { flex:1; } .doc-info p { font-size:14px; color:#57534E; line-height:1.7; margin:0; max-width:560px; }
  .doc-name { font-family:'Cormorant Garamond',serif; font-size:32px; font-weight:600; margin-bottom:8px; }
  .doc-sig { text-align:right; flex-shrink:0; }
  .sig { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:30px; color:#78716C; }
  .sig-label { font-size:11px; color:#a8a29e; letter-spacing:.08em; text-transform:uppercase; margin-top:4px; }
  /* footer */
  .footer-cta { background:#1C1917; color:#FBF9F5; }
  .footer-cta a { color:var(--accent); }
  .footer-grid { display:grid; grid-template-columns:1.2fr 1fr; gap:72px; align-items:start; padding-bottom:64px; }
  .footer-cta h2 { font-size:clamp(40px,4.5vw,64px); line-height:1.08; margin-bottom:24px; }
  .footer-cta h2 em { color:var(--accent); }
  .footer-cta .lead { color:rgba(251,249,245,.65); max-width:480px; }
  .hours { display:inline-flex; align-items:center; gap:10px; border:1px solid rgba(251,249,245,.2); border-radius:999px; padding:8px 18px; font-size:13px; font-weight:500; color:rgba(251,249,245,.8); margin-bottom:28px; }
  .dot { width:8px; height:8px; border-radius:50%; background:#8fd6a3; }
  .contact { display:flex; flex-direction:column; gap:12px; font-size:14px; color:rgba(251,249,245,.75); }
  .booking { background:rgba(251,249,245,.06); border:1px solid rgba(251,249,245,.12); border-radius:24px; padding:36px; display:flex; flex-direction:column; gap:16px; }
  .booking-title { font-family:'Cormorant Garamond',serif; font-size:26px; font-weight:600; }
  .booking input, .booking select { background:rgba(251,249,245,.08); border:1px solid rgba(251,249,245,.15); border-radius:12px; padding:14px 16px; color:#FBF9F5; font-size:14px; font-family:'Plus Jakarta Sans',sans-serif; outline:none; }
  .booking select { color:rgba(251,249,245,.7); }
  .fine { font-size:12px; color:rgba(251,249,245,.45); text-align:center; }
  .footer-bar { border-top:1px solid rgba(251,249,245,.12); padding-top:32px; padding-bottom:32px; display:flex; justify-content:space-between; align-items:center; font-size:13px; color:rgba(251,249,245,.45); }
  .f-logo { font-family:'Cormorant Garamond',serif; font-size:18px; color:rgba(251,249,245,.8); }
  .f-links { display:flex; gap:28px; }
  .f-links a { color:rgba(251,249,245,.55); }
  .grad { background:linear-gradient(100deg,var(--accent),var(--deep) 70%); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .hero-stats { display:flex; gap:56px; margin-top:52px; padding-top:32px; border-top:1px solid rgba(245,244,242,.15); }
  .stat-num { font-family:'Cormorant Garamond',serif; font-size:40px; font-weight:600; color:#F5F4F2; line-height:1; }
  .stat-label { font-size:12px; font-weight:500; letter-spacing:.1em; text-transform:uppercase; color:rgba(245,244,242,.55); margin-top:8px; }
  .outline { font-style:normal; color:transparent; -webkit-text-stroke:1px #8d8781; }
  #hair-journey, #treatments, #results, #specialists { background:var(--bg); border-radius:36px; max-width:1480px; margin:32px auto; }
  .ghost { position:absolute; top:-84px; left:-10px; font-family:'Cormorant Garamond',serif; font-size:190px; line-height:1; color:rgba(28,25,23,.05); pointer-events:none; user-select:none; }
  .g2 { top:-72px; }
  .hair-copy, .section-head { position:relative; }
  .reveal { opacity:0; transform:translateY(28px); transition:opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1); }
  .reveal.d1 { transition-delay:.15s; }
  .reveal.in { opacity:1; transform:translateY(0); }
  .card video, .card-img { transition:transform .6s ease; }
  .card:hover video, .card:hover .card-img { transform:scale(1.06); }
  .center.tight { margin-bottom:14px; }
  .center-sub { font-size:15px; color:#78716C; text-align:center; margin:0 0 28px; }
  .trust-chips { display:flex; justify-content:center; gap:14px; flex-wrap:wrap; margin-bottom:44px; }
  .chip { display:inline-flex; align-items:center; gap:8px; background:var(--surface); border:1px solid var(--border); border-radius:999px; padding:10px 20px; font-size:13px; font-weight:600; }
  .chip-star { color:var(--deep); }
  .doc-sig { display:flex; flex-direction:column; align-items:flex-end; gap:16px; }
  .btn-dark { background:#1C1917; color:#FBF9F5; font-size:13px; padding:12px 26px; }
  @media (max-width: 1000px) {
    header, .hair, .philosophy, .footer-grid { grid-template-columns:1fr; display:grid; gap:40px; }
    .cards, .testimonials { grid-template-columns:1fr 1fr; }
    .nav-links { display:none; }
  }
</style>

<script is:inline>
(() => {
  // scroll reveals
  const io = new IntersectionObserver((es) => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .12 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  setTimeout(() => document.querySelectorAll('.reveal').forEach(el => el.classList.add('in')), 4000);

  // videos: assign data-src + autoplay kick
  const kick = () => document.querySelectorAll('video').forEach(v => { if (v.dataset.src && v.getAttribute('src') !== v.dataset.src) v.src = v.dataset.src; v.muted = true; v.play().catch(() => {}); });
  kick(); const kt = setInterval(kick, 1500); setTimeout(() => clearInterval(kt), 8000);

  // scroll: graphite -> cashmere, slow eased
  const G = [69,72,78], L = [253,251,247];
  const onScroll = () => {
    const doc = document.documentElement;
    const p = Math.pow(Math.min(1, window.scrollY / ((doc.scrollHeight - innerHeight) * 0.85)), 1.6);
    const mix = (a,b) => Math.round(a + (b - a) * p);
    document.body.style.background = `rgb(${mix(G[0],L[0])},${mix(G[1],L[1])},${mix(G[2],L[2])})`;
  };
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  // hair before/after (cursor)
  const hs = document.getElementById('hair-slider');
  const setHair = (pct) => {
    document.getElementById('hair-after').style.clipPath = `inset(0 0 0 ${pct}%)`;
    document.getElementById('hair-divider').style.left = pct + '%';
    const d = Math.round(100 - pct);
    document.getElementById('hair-pct').textContent = d + '%';
    document.getElementById('hair-fill').style.width = d + '%';
    document.querySelectorAll('.milestone').forEach(m => m.classList.remove('active'));
    const idx = pct > 66 ? 1 : pct > 33 ? 2 : 3;
    document.querySelector(`.milestone[data-m="${idx}"]`).classList.add('active');
  };
  hs.addEventListener('mousemove', (e) => { const r = hs.getBoundingClientRect(); setHair(Math.max(0, Math.min(100, (e.clientX - r.left) / r.width * 100))); });
  hs.addEventListener('touchmove', (e) => { const r = hs.getBoundingClientRect(); setHair(Math.max(0, Math.min(100, (e.touches[0].clientX - r.left) / r.width * 100))); }, { passive: true });
  setHair(50);

  // results slider (range)
  const rr = document.getElementById('results-range');
  rr.addEventListener('input', () => {
    document.getElementById('results-after').style.clipPath = `inset(0 ${100 - rr.value}% 0 0)`;
    document.getElementById('results-divider').style.left = rr.value + '%';
  });

  // particles + sun/moon on graphite hero
  const canvas = document.getElementById('aura-particles');
  const ctx = canvas.getContext('2d');
  const wrap = document.getElementById('hero-wrap');
  let w, h;
  const resize = () => { w = canvas.width = wrap.clientWidth; h = canvas.height = wrap.clientHeight; };
  resize(); addEventListener('resize', resize);
  const N = 42;
  const pts = Array.from({ length: N }, () => ({ x: Math.random() * w, y: Math.random() * h, vx: (Math.random() - .5) * .25, vy: (Math.random() - .5) * .25, r: 1 + Math.random() * 2.2 }));
  const lerp = (a,b,t) => a + (b - a) * t;
  const CYCLE = 180000, start = performance.now();
  const drawOrb = (x, y, r, isSun, alpha) => {
    const glow = ctx.createRadialGradient(x, y, 0, x, y, r * 5);
    const c = isSun ? '230,178,105' : '168,182,214';
    glow.addColorStop(0, `rgba(${c},${.75 * alpha})`); glow.addColorStop(1, `rgba(${c},0)`);
    ctx.fillStyle = glow; ctx.beginPath(); ctx.arc(x, y, r * 5, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = isSun ? `rgba(235,178,96,${alpha})` : `rgba(196,206,232,${alpha})`;
    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
    if (!isSun) { ctx.fillStyle = `rgba(69,72,78,${.85 * alpha})`; ctx.beginPath(); ctx.arc(x - r * .38, y - r * .2, r * .82, 0, Math.PI * 2); ctx.fill(); }
  };
  const tick = () => {
    ctx.clearRect(0, 0, w, h);
    const t = ((performance.now() - start) % CYCLE) / CYCLE;
    const day = 1 - Math.abs(((t + .5) % 1) * 2 - 1);
    const D = [69,72,78], NR = [52,55,60];
    wrap.style.background = `rgb(${Math.round(lerp(NR[0],D[0],day))},${Math.round(lerp(NR[1],D[1],day))},${Math.round(lerp(NR[2],D[2],day))})`;
    const arc = (ph) => { const p = ph % 1; return { x: lerp(-60, w + 60, p), y: h * .55 - Math.sin(p * Math.PI) * h * .42, vis: Math.max(0, Math.sin(p * Math.PI)) }; };
    const sun = arc(t), moon = arc(t + .5);
    if (sun.vis > .01) drawOrb(sun.x, sun.y, 38, true, Math.min(1, sun.vis * 2));
    if (moon.vis > .01) drawOrb(moon.x, moon.y, 30, false, Math.min(1, moon.vis * 2));
    for (const p of pts) { p.x += p.vx; p.y += p.vy; if (p.x < -10) p.x = w + 10; if (p.x > w + 10) p.x = -10; if (p.y < -10) p.y = h + 10; if (p.y > h + 10) p.y = -10; }
    ctx.lineWidth = 1;
    for (let i = 0; i < N; i++) for (let j = i + 1; j < N; j++) {
      const a = pts[i], b = pts[j], d = Math.hypot(a.x - b.x, a.y - b.y);
      if (d < 140) { ctx.strokeStyle = `rgba(201,166,143,${(.16 * (1 - d / 140)).toFixed(3)})`; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); }
    }
    for (const p of pts) { ctx.fillStyle = 'rgba(201,166,143,.35)'; ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill(); }
    requestAnimationFrame(tick);
  };
  tick();
})();
</script>
</body>
</html>
