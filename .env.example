# SMTP delivery for the hair-transplant landing-page form
# (/landing-haartransplantation-offer -> /api/haartransplantation-anfrage).
#
# These are read from the RUNTIME environment (process.env), not from the build,
# so on the server put them in the systemd unit for astro-asclinic
# (Environment= / EnvironmentFile=) rather than into the built output.
# Locally, `astro dev` picks up a .env file next to this one.

SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@asclinic.de
SMTP_PASS=

# Envelope sender. Most providers, STRATO included, require this to be the
# authenticated mailbox — the visitor's address goes into Reply-To instead.
LEAD_MAIL_FROM="AS Clinic Website <info@asclinic.de>"

# Recipient. Defaults to CLINIC.email (info@asclinic.de) when unset.
LEAD_MAIL_TO=info@asclinic.de

# Where a request is written if SMTP is unconfigured or the send fails, so a
# mail outage never costs a lead. These files contain health-related photos:
# keep the directory outside the web root, chmod 700, and purge it in step with
# the 30-day deletion promise in the privacy notice. Defaults to ./.leads
LEAD_FALLBACK_DIR=/var/lib/asclinic/leads
