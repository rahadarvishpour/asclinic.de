---
import TreatmentDetail from "../../../components/TreatmentDetail.astro";
import { TREATMENT_PAGES, treatmentPagesFor } from "../../../data/treatmentPages";
import { TREATMENTS, unsplash } from "../../../data/treatments";
import { treatmentImage } from "../../../data/treatmentImages";

export function getStaticPaths() {
  // Only the treatments published in this locale get a URL here; a treatment
  // without en copy has no en page rather than an English one.
  return treatmentPagesFor("en").map((page) => ({ params: { slug: page.slug } }));
}

const { slug } = Astro.params as { slug: string };
const page = TREATMENT_PAGES[slug];

const photoId = TREATMENTS.find((t) => t.slug === slug)?.photoId;
const image = treatmentImage(slug) ?? (photoId ? unsplash(photoId, 1200, 80) : "");
---
<TreatmentDetail locale="en" page={page} image={image} />
