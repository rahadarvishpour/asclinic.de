---
import { t, LOCALES, type Locale } from "../i18n/ui";
import { HAIR_SERVICES, SURGERY_PROCEDURES } from "../data/treatments";
import { CLINIC } from "../data/clinic";
interface Props { locale: Locale }
const { locale } = Astro.props;
// Each figure is derived from data the site actually publishes, so it can be
// checked against the page and cannot drift out of date. Unsourced marketing
// statistics (guests treated, satisfaction %) were removed deliberately.
const openingDays = CLINIC.openingHours.reduce((n, h) => n + h.days.length, 0);
const STATS = [
  { value: String(HAIR_SERVICES.length), key: "stats.1" as const },
  { value: String(SURGERY_PROCEDURES.length), key: "stats.2" as const },
  { value: String(LOCALES.length), key: "stats.3" as const },
  { value: String(openingDays), key: "stats.4" as const }
];
---

<section class="section section--quiet">
  <div class="container grid grid--4 stagger" style="text-align:center">
    {STATS.map((s) => (
      <div class="reveal" data-reveal="up">
        <div class="stat__value">{s.value}</div>
        <div class="stat__label">{t(locale, s.key)}</div>
      </div>
    ))}
  </div>
</section>
