---
/** Pabau lead-capture form embedded on a page (Pabau's own iframe snippet).
 *
 *  The iframe is a fixed height (Pabau does not report the form's height to the
 *  parent page), chosen tall enough that the whole form shows without a
 *  scrollbar inside the frame; it is taller on narrow screens, where the form's
 *  fields stack and the form gets longer. Adjust --pabau-h below if the form's
 *  length changes in Pabau. */
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  /** Pabau capture form number, e.g. 151 for …/capture/151. */
  formId: number;
  /** The iframe title Pabau's embed snippet gives this form. */
  title: string;
}
const { locale, formId, title } = Astro.props;
const src = `https://booking-eu.pabau.com/as-clinic-u1rcva6e/capture/${formId}?t=1`;
---

<section class="section" style="padding-block:var(--sp-7)">
  <div class="container prose">
    <h2 class="h2">{t(locale, "treat.hairAnalysis")}</h2>
    <!-- Pabau -->
    <iframe
      id={`cf-${formId}`}
      class="pabau-embed"
      src={src}
      title={title}
      loading="lazy"
    ></iframe>
    <!-- End Pabau -->
  </div>
</section>

<style>
  .pabau-embed {
    --pabau-h: 1100px;
    display: block; width: 100%; height: var(--pabau-h); border: 0;
    margin-top: var(--sp-5);
  }
  @media (max-width: 640px) {
    .pabau-embed { --pabau-h: 1400px; }
  }
</style>
