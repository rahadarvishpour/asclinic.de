---
import { t, ti, type Locale } from "../i18n/ui";
import { GOOGLE_REVIEWS, GOOGLE_RATING } from "../data/reviews";
import { CLINIC } from "../data/clinic";
interface Props { locale: Locale }
const { locale } = Astro.props;

// One "slide" is a scroll-snap point holding exactly three review cards, per
// the site's own request — not a responsive column count.
const SLIDE_SIZE = 3;
const slides = Array.from({ length: Math.ceil(GOOGLE_REVIEWS.length / SLIDE_SIZE) }, (_, i) =>
  GOOGLE_REVIEWS.slice(i * SLIDE_SIZE, i * SLIDE_SIZE + SLIDE_SIZE)
);
---

<section id="reviews" class="section" style="background:var(--bg-quiet)">
  <div class="container">
    <div style="display:flex; flex-wrap:wrap; align-items:end; justify-content:space-between; gap:var(--sp-5)">
      <div style="display:grid; gap:var(--sp-3)">
        <p class="eyebrow reveal" data-reveal="up">{t(locale, "rev.eyebrow")}</p>
        <h2 class="h1 reveal" data-reveal="up">{t(locale, "rev.title")}</h2>
        <p class="lead reveal" data-reveal="up" style="color:var(--text-muted)">
          {ti(locale, "rev.lead", { rating: GOOGLE_RATING.average.toFixed(1), count: String(GOOGLE_RATING.count) })}
        </p>
      </div>
      <div style="display:flex; gap:var(--sp-2)">
        <button type="button" class="reviews-nav" data-reviews-prev aria-label={t(locale, "rev.prev")}>←</button>
        <button type="button" class="reviews-nav" data-reviews-next aria-label={t(locale, "rev.next")}>→</button>
      </div>
    </div>
  </div>
  <div class="reviews-track" data-reviews-track style="margin-top:var(--sp-7)">
    {slides.map((slide) => (
      <div class="reviews-slide">
        {slide.map((r) => (
          <figure class="review-card">
            <p class="stars" aria-hidden="true">{"★".repeat(r.rating)}</p>
            <blockquote class="quote">{r.text}</blockquote>
            <figcaption style="display:flex; align-items:center; gap:var(--sp-3); margin-top:var(--sp-5)">
              <div class="avatar" aria-hidden="true">
                <span class="avatar__fallback">{r.author.charAt(0)}</span>
                <img
                  class="avatar__img"
                  src={r.avatarUrl}
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  onerror="this.remove()"
                />
              </div>
              <div>
                <p class="body" style="margin:0; font-weight:500">{r.author}</p>
                <p class="meta" style="color:var(--text-faint)">{r.relativeTime} · {t(locale, "rev.source")}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    ))}
  </div>
  <div class="container" style="margin-top:var(--sp-6)">
    <a class="link-underline" href={CLINIC.googleReviews} target="_blank" rel="noopener noreferrer">{t(locale, "rev.cta")}</a>
    {locale === "de" && <a class="link-underline" href="/uber-uns" style="margin-inline-start:var(--sp-6)">Mehr über AS Clinic Berlin</a>}</div>
</section>

<style>
  .reviews-nav {
    width: 52px; height: 52px; border-radius: var(--r-pill); border: 1px solid var(--border);
    background: none; color: var(--text); font-size: 1.1rem; cursor: pointer;
    transition: background var(--dur-base) var(--ease-soft), border-color var(--dur-base) var(--ease-soft), color var(--dur-base) var(--ease-soft);
  }
  .reviews-nav:hover { background: var(--accent); border-color: var(--accent); color: var(--g-white); }

  .reviews-track {
    display: flex; gap: var(--sp-6); overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 0 var(--gutter) var(--sp-4); scrollbar-width: none;
  }
  .reviews-track::-webkit-scrollbar { display: none; }
  .reviews-slide {
    flex: 0 0 100%; scroll-snap-align: start;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-6);
  }
  .review-card {
    margin: 0; padding: var(--sp-6); background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); display: flex; flex-direction: column;
  }
  .review-card .quote {
    font-size: var(--fs-h4); line-height: 1.5; margin: var(--sp-3) 0 0; color: var(--text);
    display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden;
  }
  .avatar {
    position: relative; overflow: hidden; display: grid; place-items: center;
    font-family: var(--font-display); color: var(--accent-action);
  }
  .avatar__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 860px) {
    .reviews-slide { grid-template-columns: 1fr; }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-reviews-track]");
  const prev = document.querySelector<HTMLButtonElement>("[data-reviews-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-reviews-next]");
  if (track && prev && next) {
    const scrollByOne = (dir: 1 | -1) => {
      const slide = track.querySelector<HTMLElement>(".reviews-slide");
      const amount = (slide?.offsetWidth ?? track.clientWidth) + 24;
      track.scrollBy({ left: dir * amount, behavior: "smooth" });
    };
    prev.addEventListener("click", () => scrollByOne(-1));
    next.addEventListener("click", () => scrollByOne(1));
  }
</script>
