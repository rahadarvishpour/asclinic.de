    hero: {
      eyebrow: "About us",
      h1: "About AS Clinic Berlin",
      lead: "AS Clinic Berlin is a clinic on Kurfürstendamm in Berlin-Charlottenburg that specialises in hair transplantation and the treatment of hair loss. We work with modern DHI and Micro-FUE techniques and look after you personally, from the first consultation through to aftercare.",
      figures: [["Experience", "over 12 years"], ["Hair transplants performed", "over 4,000"]],
      focusCta: "Our specialities"
    },
    specialised: {
      h2: "Specialised in hair transplantation in Berlin",
      lead: "Hair transplantation is the focus of AS Clinic Berlin. With over 12 years of experience and more than 4,000 hair transplants performed, our work centres on hair transplantation and the treatment of hair loss.",
