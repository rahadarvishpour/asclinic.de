const c = COPY[locale];

const TITLE = c.title;
const DESCRIPTION = c.description;

// Social-preview image: the same real clinic photo, cropped to the 1200×630 the layout declares.
const ogImage = await getImage({ src: office, width: 1200, height: 630, fit: "cover", format: "jpg" });
const ogImageUrl = `${site}${ogImage.src}`;
const heroImage = await getImage({ src: office, width: 1200, format: "jpg" });

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${pageUrl}#webpage`,
  "url": pageUrl,
  "name": TITLE,
  "description": DESCRIPTION,
  "inLanguage": locale,
  "isPartOf": { "@type": "WebSite", "name": "AS Clinic Berlin", "url": site },
  "about": { "@id": clinicId },
  "mainEntity": { "@id": clinicId },
  "primaryImageOfPage": { "@type": "ImageObject", "contentUrl": `${site}${heroImage.src}`, "width": heroImage.attributes.width, "height": heroImage.attributes.height },
  "breadcrumb": { "@id": `${pageUrl}#breadcrumb` }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${pageUrl}#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t(locale, "breadcrumb.home"), "item": `${site}${localePath(locale)}` },
    { "@type": "ListItem", "position": 2, "name": c.crumb, "item": pageUrl }
  ]
};

// Announcement strip for this page: only wording confirmed for it (the site-wide strip promises a free first consultation and six languages).
const TOPBAR: [string, string, string] = [t(locale, "top.1"), c.topbar[0], c.topbar[1]];

const FOCUS = c.focus.items.map((f) => ({ ...f, href: link(`/treatments/${f.slug}`) }));

