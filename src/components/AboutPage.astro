---
/** Über AS Clinic Berlin — the "Über uns" page (/uber-uns, /en/uber-uns).
 *
 *  Published in German and English (see ABOUT_LOCALES in ../i18n/ui). The page
 *  keeps the same slug in both locales, like every other page on the site, so
 *  canonical, hreflang and the language switcher pair the two versions up
 *  without special cases. The English copy is a faithful translation of the
 *  German — it makes no claim the German page does not make.
 *
 *  Every statement here comes from information the clinic has confirmed for
 *  this page or that is already published on the site (Impressum, contact and
 *  location pages). Deliberately absent, until verified separately: any
 *  physician biography or role beyond "Facharzt für Chirurgie", any other team
 *  member, certifications or accreditations, diagnostic equipment, consultation
 *  prices or "free" consultation wording, and any portrait.
 *  Treatment detail lives on the dedicated treatment pages; this page links to
 *  them instead of competing with them. */
import { Picture, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { CLINIC } from "../data/clinic";
import { GOOGLE_RATING } from "../data/reviews";
import { ABOUT_LOCALES, ABOUT_PATH, bookingUrl, localePath, t } from "../i18n/ui";
import type { AboutLocale } from "../i18n/ui";
import office from "../assets/clinic/office.jpg";

interface Props { locale: AboutLocale }
const { locale } = Astro.props;
const site = (Astro.site?.toString() ?? "https://asclinic.de").replace(/\/$/, "");
const PAGE_PATH = ABOUT_PATH;
const pageUrl = `${site}${localePath(locale, PAGE_PATH)}`;
const clinicId = `${site}/#clinic`;
const bookHref = bookingUrl(locale);
const link = (path: string) => localePath(locale, path);

const ratingValue = GOOGLE_RATING.average.toFixed(1);

