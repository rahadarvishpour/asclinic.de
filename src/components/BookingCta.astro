---
import { Image } from "astro:assets";
import { t, type Locale } from "../i18n/ui";
import { CLINIC } from "../data/clinic";
import officeImage from "../assets/clinic/office.jpg";
interface Props { locale: Locale }
const { locale } = Astro.props;
// The panel is half the viewport above 980px and full width below it.
const PANEL_SIZES = "(max-width: 980px) 100vw, 50vw";
const PANEL_WIDTHS = [640, 960, 1448];
---

<section id="book" class="section" style="padding:0">
  <div data-split="1" style="display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); align-items:stretch; min-height:640px">
    <div class="cta-media" style="position:relative; background:var(--g-blush)">
      <Image src={officeImage} alt={t(locale, "cta.imgAlt")} widths={PANEL_WIDTHS} sizes={PANEL_SIZES} width={960} height={720} style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover" />
    </div>
    <div style="background:var(--bg-invert); color:var(--text-invert); display:grid; align-content:center; gap:var(--sp-5); padding:var(--sp-9) var(--gutter)">
      <p class="eyebrow" style="color:var(--accent)">{t(locale, "cta.eyebrow")}</p>
      <h2 class="h1">{t(locale, "cta.title")}</h2>
      <p class="lead" style="color:rgba(246,241,237,.72); max-width:44ch">{t(locale, "cta.lead")}</p>
      <form id="cta-form" data-email={CLINIC.email} style="display:grid; gap:var(--sp-4); max-width:460px">
        <div class="field">
          <label class="visually-hidden" for="cta-name">{t(locale, "cta.name")}</label>
          <input class="input" type="text" id="cta-name" name="name" placeholder={t(locale, "cta.name")} required />
        </div>
        <div class="field">
          <label class="visually-hidden" for="cta-phone">{t(locale, "cta.phone")}</label>
          <input class="input" type="tel" id="cta-phone" name="phone" placeholder={t(locale, "cta.phone")} required />
        </div>
        <div class="field">
          <label class="visually-hidden" for="cta-service">{t(locale, "cta.service")}</label>
          <select class="select" id="cta-service" name="service">
            <option value="">{t(locale, "cta.service")}</option>
            <option value="injectables">{t(locale, "nav.inject")}</option>
            <option value="hair">{t(locale, "nav.hair")}</option>
            <option value="surgery">{t(locale, "nav.surgery")}</option>
          </select>
        </div>
        <button type="submit" class="btn btn--light btn--lg btn--block">{t(locale, "cta.submit")}</button>
      </form>
    </div>
  </div>
</section>

<script>
  // A native <form action="mailto:..."> makes Chrome flag the page for
  // "insecure form" / mixed content (mailto: isn't https), which tanks the
  // Lighthouse Best Practices score. Building and navigating to the mailto:
  // link ourselves avoids that check entirely and works more reliably.
  const form = document.querySelector<HTMLFormElement>("#cta-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const email = form.dataset.email;
    const data = new FormData(form);
    const name = String(data.get("name") ?? "");
    const phone = String(data.get("phone") ?? "");
    const service = String(data.get("service") ?? "");
    const subject = encodeURIComponent(`Terminanfrage: ${name}`);
    const body = encodeURIComponent(`Name: ${name}\nTelefon: ${phone}\nBereich: ${service}`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
