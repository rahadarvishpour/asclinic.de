---
import { Image } from "astro:assets";
import { t, type Locale } from "../i18n/ui";
import { treatmentImage } from "../data/treatmentImages";
import { SURGERY_PROCEDURES, unsplash, unsplashSrcSet } from "../data/treatments";

const CARD_WIDTHS = [600, 900, 1200];
const CARD_SIZES = "(max-width: 620px) 100vw, 560px";
interface Props { locale: Locale }
const { locale } = Astro.props;
---

<section id="surgery" class="section">
  <div class="container">
    <div class="section-head" style="display:grid; gap:var(--sp-3); max-width:760px">
      <p class="eyebrow reveal" data-reveal="up">{t(locale, "s3.eyebrow")}</p>
      <h2 class="h1 reveal" data-reveal="up">{t(locale, "s3.title")}</h2>
      <p class="lead reveal" data-reveal="up" style="color:var(--text-muted)">{t(locale, "s3.lead")}</p>
    </div>
    <div class="grid grid--2 stagger" style="margin-top:var(--sp-7); gap:var(--sp-7)">
      {SURGERY_PROCEDURES.map((proc) => (
        <div class="card card--cream reveal" data-reveal="up" style="display:grid; gap:var(--sp-4)">
          <div class="media" style="height:340px; position:relative">
            {treatmentImage(proc.slug) ? (
              <Image src={treatmentImage(proc.slug)!} alt={t(locale, proc.altKey)} width={900} height={600} widths={CARD_WIDTHS} sizes={CARD_SIZES} style="width:100%; height:100%; object-fit:cover; border-radius:var(--r-image)" />
            ) : (
              <img src={unsplash(proc.photoId, 900, 75)} srcset={unsplashSrcSet(proc.photoId, CARD_WIDTHS, 75)} sizes={CARD_SIZES} alt={t(locale, proc.altKey)} loading="lazy" decoding="async" width="1200" height="340" style="width:100%; height:100%; object-fit:cover; border-radius:var(--r-image)" />
            )}
            {!treatmentImage(proc.slug) && (
              <span class="photo-credit">
                {t(locale, "credit.photoBy")} <a href={proc.creditHref} target="_blank" rel="noopener noreferrer">{proc.photographer}</a> {t(locale, "credit.on")} Unsplash
              </span>
            )}
          </div>
          <span class="chip chip--outline">{t(locale, proc.chipKey)}</span>
          <h3 class="h2">{t(locale, proc.titleKey)}</h3>
          <p class="body" style="color:var(--text-muted)">{t(locale, proc.descKey)}</p>
          <a class="btn btn--dark" href="#book">{t(locale, "s3.cta")}</a>
        </div>
      ))}
    </div>
  </div>
</section>
