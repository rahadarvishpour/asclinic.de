---
import { localePath, stripLocalePrefix, bookingUrl, hasContactPage, type Locale } from "../i18n/ui";
import { t, sectionHref } from "../i18n/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;

// Home is where the anchored sections (#injectables, #book, etc.) actually
// live — from any other page (e.g. a treatment detail page) these need to
// point back at the homepage first, not scroll nowhere on the current page.
const homeHref = localePath(locale);
const anchor = (id: string) => sectionHref(locale, Astro.url.pathname, id);

// The contact page exists in German and English only, so it joins the nav in
// those locales and is left out of the others rather than 404-ing.
const NAV = [
  { href: anchor("injectables"), key: "nav.inject" as const },
  { href: anchor("hair"), key: "nav.hair" as const },
  { href: anchor("surgery"), key: "nav.surgery" as const },
  { href: anchor("results"), key: "nav.results" as const },
  { href: anchor("faq"), key: "nav.faq" as const },
  ...(hasContactPage(locale) ? [{ href: localePath(locale, "/contact"), key: "nav.contact" as const }] : [])
];
const bookHref = bookingUrl(locale);

const currentPath = Astro.url.pathname;

// The brand logo is the conventional "go home" control. On the homepage it
// scrolls back to the top; from any other page it navigates to the homepage.
const onHomepage = stripLocalePrefix(currentPath) === "/";
const brandHref = onHomepage ? "#top" : homeHref;
---

<div class="topbar marquee">
  <div class="marquee__track">
    {Array.from({ length: 2 }).flatMap(() => [
      <span class="marquee__item">{t(locale, "top.1")}</span>,
      <span class="marquee__item">{t(locale, "top.2")}</span>,
      <span class="marquee__item">{t(locale, "top.3")}</span>
    ])}
  </div>
</div>

<header class="header--sticky">
  <div class="container nav">
    <a href={brandHref} class="brand-link" style="display:inline-flex; align-items:center; gap:var(--sp-3); color:var(--text); text-decoration:none; min-width:0">
      <img src="/assets/logo.jpg" width="48" height="48" alt={t(locale, "brand.logoAlt")} style="width:48px; height:48px; border-radius:var(--r-pill); object-fit:cover; background:#000; flex:none" />
      <span style="font-family:var(--font-display); font-size:1.35rem; line-height:1.05">{t(locale, "hero.title")}</span>
    </a>
    <nav data-desknav="1">
      <ul class="nav__links">
        {NAV.map((item) => (
          <li><a href={item.href}>{t(locale, item.key)}</a></li>
        ))}
      </ul>
    </nav>
    <div style="display:flex; align-items:center; gap:var(--sp-3)">
      <a class="btn nav-cta" href={bookHref}>{t(locale, "nav.cta")}</a>
      <details class="burger-details" data-burger="1">
        <summary class="burger-summary" aria-label={t(locale, "nav.menu")}>≡</summary>
        <div class="drawer">
          <div class="container" style="display:grid; gap:var(--sp-2); padding-block:var(--sp-5)">
            {NAV.map((item) => (
              <a href={item.href} style="font-family:var(--font-display); font-size:var(--fs-h3); color:var(--text)">{t(locale, item.key)}</a>
            ))}
            <a class="btn" href={bookHref} style="margin-top:var(--sp-3); justify-self:start">{t(locale, "nav.cta")}</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  [data-burger] { display: none; }
  .burger-summary {
    display: none; align-items: center; justify-content: center; width: 42px; height: 42px;
    background: var(--g-charcoal); color: #F6F1ED; border-radius: var(--r-pill); font-size: 1.1rem; cursor: pointer; list-style: none;
  }
  .burger-summary::-webkit-details-marker { display: none; }
  .drawer {
    position: absolute; inset-inline: 0; top: 100%; left: 0; right: 0; width: 100%;
    border-top: 1px solid var(--border); background: var(--surface); z-index: 30;
    box-shadow: var(--sh-2);
  }
  .drawer .container { display: flex; flex-direction: column; }

  @media (max-width: 980px) {
    [data-desknav] { display: none !important; }
    [data-burger] { display: block; }
    .burger-summary { display: flex; }
  }

  .nav { flex-wrap: nowrap; }
  @media (max-width: 640px) {
    .nav { gap: var(--sp-3); }
    .nav-cta { display: none; }
  }
</style>

<script>
  // Explicit toggle (rather than relying solely on native <summary> default
  // action) so the drawer opens reliably for every input type, including
  // synthetic/automated click dispatch.
  document.querySelectorAll<HTMLElement>(".burger-summary").forEach((summary) => {
    summary.addEventListener("click", (e) => {
      e.preventDefault();
      const details = summary.closest("details");
      if (!details) return;
      details.open = !details.open;
    });
  });

  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>(".burger-details[open]").forEach((el) => {
      if (!el.contains(e.target as Node)) el.removeAttribute("open");
    });
  });
</script>
