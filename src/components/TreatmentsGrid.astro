---
import { Image } from "astro:assets";
import { t, ti, localePath, type Locale } from "../i18n/ui";
import { TREATMENTS, unsplash, unsplashSrcSet, PHOTO_CREDITS } from "../data/treatments";
import { TREATMENT_PAGES, treatmentContent } from "../data/treatmentPages";
import { treatmentImage } from "../data/treatmentImages";
interface Props { locale: Locale }
const { locale } = Astro.props;

// Every treatment now has a dedicated detail page, which is also where each
// card's translated title and alt text come from.
const DETAIL_SLUGS = new Set(Object.keys(TREATMENT_PAGES));
const cardCopy = (slug: string) => treatmentContent(TREATMENT_PAGES[slug], locale);
// Once every card carries the clinic's own photography the Unsplash credit is no
// longer true, so it is only rendered while at least one stock image remains.
const usesStockPhotography = TREATMENTS.some((tr) => !treatmentImage(tr.slug));
const homeHref = localePath(locale);
const bookHref = `${homeHref === "/" ? "" : homeHref}#book`;
const hrefFor = (slug: string) => (DETAIL_SLUGS.has(slug) ? localePath(locale, `/treatments/${slug}`) : bookHref);

// A card renders ~268px in the 4-up desktop grid, ~45vw in the 2-up tablet grid
// and ~40vw in the phone scroller — so ship thumbnails, not the 900px master.
const CARD_WIDTHS = [280, 560, 900];
const CARD_SIZES = "(max-width: 620px) 40vw, (max-width: 980px) 45vw, 268px";
---

<section id="injectables" class="section">
  <div class="container">
    <div class="section-head" style="display:grid; gap:var(--sp-3); max-width:760px">
      <p class="eyebrow reveal" data-reveal="up">{t(locale, "s1.eyebrow")}</p>
      <h2 class="h1 reveal" data-reveal="up">{t(locale, "s1.title")}</h2>
      <p class="lead reveal" data-reveal="up" style="color:var(--text-muted)">{t(locale, "s1.lead")}</p>
    </div>
    <div class="grid grid--4 stagger treatments-grid" style="margin-top:var(--sp-7)">
      {TREATMENTS.map((tr) => { const copy = cardCopy(tr.slug); return (
        <a class="arch-card hover-zoom reveal" data-fade="1" data-reveal="up" href={hrefFor(tr.slug)}>
          <div class="media media--arch" style="aspect-ratio:4/5">
            {treatmentImage(tr.slug) ? (
              <Image src={treatmentImage(tr.slug)!} alt={copy.imageAlt} width={560} height={700} widths={CARD_WIDTHS} sizes={CARD_SIZES} style="width:100%; height:100%; object-fit:cover" />
            ) : (
              <img src={unsplash(tr.photoId, 560)} srcset={unsplashSrcSet(tr.photoId, CARD_WIDTHS)} sizes={CARD_SIZES} alt={copy.imageAlt} loading="lazy" decoding="async" width="900" height="1125" style="width:100%; height:100%; object-fit:cover" />
            )}
          </div>
          <div class="arch-card__bar">
            <span class="arch-card__title">{copy.title}</span>
            <span class="plus" aria-hidden="true">+</span>
          </div>
        </a>
      ); })}
    </div>
    {usesStockPhotography && (
      <p class="meta" style="margin-top:var(--sp-5); color:var(--text-faint)">{ti(locale, "grid.credits", { credits: PHOTO_CREDITS })}</p>
    )}
  </div>
</section>

<style>
  @media (max-width: 620px) {
    .treatments-grid {
      display: flex;
      grid-template-columns: none;
      gap: var(--sp-4);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      padding-bottom: var(--sp-3);
      scrollbar-width: none;
    }
    .treatments-grid::-webkit-scrollbar { display: none; }
    .treatments-grid > * {
      flex: 0 0 40%;
      min-width: 148px;
      scroll-snap-align: start;
    }
    .treatments-grid .arch-card__title { font-size: var(--fs-xs); }
    .treatments-grid .arch-card__bar { padding: var(--sp-2) var(--sp-2) var(--sp-2) var(--sp-3); }
    .treatments-grid .plus { width: 28px; height: 28px; font-size: .9rem; }
  }
</style>
