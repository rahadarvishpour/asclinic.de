---
import { t, sectionHref, localePath, hasContactPage, type Locale } from "../i18n/ui";
import { CLINIC } from "../data/clinic";
interface Props { locale: Locale }
const { locale } = Astro.props;
const year = new Date().getFullYear();
const anchor = (id: string) => sectionHref(locale, Astro.url.pathname, id);

// Layout lives entirely in components.css (.footer__*) — inline grid styles here
// would outrank the responsive media queries and pin the footer to four columns
// on phones.
---

<footer class="footer">
  <div class="container">
    <div class="footer__cols">
      <div class="footer__brand">
        <img class="footer__logo" src="/assets/logo.jpg" alt={t(locale, "ft.logoAlt")} width="132" height="132" loading="lazy" decoding="async" />
        <p class="body footer__tagline">{t(locale, "ft.tagline")}</p>
        <div class="footer__social">
          <a class="social" href={CLINIC.social.instagram} target="_blank" rel="noopener noreferrer me" aria-label="Instagram">IG</a>
          <a class="social" href={CLINIC.social.tiktok} target="_blank" rel="noopener noreferrer me" aria-label="TikTok">TT</a>
          <a class="social" href={CLINIC.social.telegram} target="_blank" rel="noopener noreferrer me" aria-label="Telegram">TG</a>
          <a class="social" href={CLINIC.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">WA</a>
        </div>
      </div>
      <div class="footer__col">
        <span class="eyebrow">{t(locale, "ft.explore")}</span>
        <a href={anchor("injectables")}>{t(locale, "nav.inject")}</a>
        <a href={anchor("hair")}>{t(locale, "nav.hair")}</a>
        <a href={anchor("surgery")}>{t(locale, "nav.surgery")}</a>
        <a href={anchor("faq")}>{t(locale, "nav.faq")}</a>
        <a href={localePath(locale, "/location")}>{t(locale, "nav.location")}</a>
        {hasContactPage(locale) && <a href={localePath(locale, "/contact")}>{t(locale, "nav.contact")}</a>}
      </div>
      <div class="footer__col">
        <span class="eyebrow">{t(locale, "ft.hours")}</span>
        <span class="body">{t(locale, "ft.hours1")}</span>
        <span class="body">{t(locale, "ft.hours2")}</span>
        <span class="body">{t(locale, "ft.hours3")}</span>
      </div>
      <div class="footer__col">
        <span class="eyebrow">{t(locale, "ft.clinic")}</span>
        <span class="body">{CLINIC.streetAddress}<br />{CLINIC.postalCode} {CLINIC.addressLocality} · {CLINIC.district}</span>
        <a href={`tel:${CLINIC.telephone}`}>{CLINIC.telephoneDisplay}</a>
        <a href={CLINIC.url}>asclinic-berlin.de</a>
      </div>
    </div>
    <div class="footer__bottom">
      <span class="meta">© {year} {CLINIC.name} Berlin. {t(locale, "ft.rights")}</span>
      <span class="footer__legal">
        <a href="/impressum">{t(locale, "ft.imprint")}</a>
        <a href="/datenschutz">{t(locale, "ft.privacy")}</a>
      </span>
      <span class="meta footer__langs">English · Deutsch · Español · Русский · فارسی · العربية</span>
    </div>
  </div>
</footer>
