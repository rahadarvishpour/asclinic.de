---
import { LOCALES, DEFAULT_LOCALE, localePath, getLocaleMeta, t, type Locale } from "../i18n/ui";
import { CLINIC } from "../data/clinic";
import { faqFor } from "../data/faqs";
import "../styles/global.css";
// Hashed URLs of the self-hosted fonts that paint the first screen (see fonts.css).
import dmSansLatin from "../assets/fonts/dm-sans-latin.woff2?url";
import playfairLatin from "../assets/fonts/playfair-display-latin.woff2?url";
import playfairCyrillic from "../assets/fonts/playfair-display-cyrillic.woff2?url";
import playfairItalicLatin from "../assets/fonts/playfair-display-italic-latin.woff2?url";
import playfairItalicCyrillic from "../assets/fonts/playfair-display-italic-cyrillic.woff2?url";

export interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  includeFaqSchema?: boolean;
  /** The locale-independent part of the URL, e.g. "/treatments/lip-filler". Defaults to "" (homepage). Canonical and hreflang links are derived from this per locale, so they always point at the equivalent page rather than always the homepage. */
  unprefixedPath?: string;
  /** Set false to skip hreflang alternates — for pages that don't have translated equivalents at other locale paths yet. */
  hreflangAlternates?: boolean;
  /** The locales this page actually exists in. Defaults to all of them; pass a
   *  subset for pages published in fewer languages, so hreflang never advertises
   *  a URL that was never built. */
  hreflangLocales?: Locale[];
  /** Keeps the page out of the index — for campaign landing pages and the
   *  thank-you page they hand off to, which would otherwise compete with the
   *  editorial treatment pages for the same queries. */
  noindex?: boolean;
  /** Leaves out <link rel="canonical"> — for the 404 page, which has no URL of its own to canonicalise. */
  omitCanonical?: boolean;
  /** The page's first screen sets italic Playfair (the homepage hero headline), so that file is preloaded too. */
  preloadItalic?: boolean;
}

const { locale, title, description, ogImage, includeFaqSchema = true, unprefixedPath = "", hreflangAlternates = true, hreflangLocales, noindex = false, omitCanonical = false, preloadItalic = false } = Astro.props;
const alternateLocales = hreflangLocales
  ? LOCALES.filter((l) => hreflangLocales.includes(l.code))
  : LOCALES;
// x-default points at the default locale's URL only when that page exists there.
const xDefaultLocale = alternateLocales.some((l) => l.code === DEFAULT_LOCALE) ? DEFAULT_LOCALE : alternateLocales[0]?.code;
const meta = getLocaleMeta(locale);
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://asclinic.de";
const canonicalPath = localePath(locale, unprefixedPath);
const canonicalUrl = `${site}${canonicalPath}`;
const defaultOgImage = "https://images.unsplash.com/photo-1519494140681-8b17d830a3e9?fm=jpg&q=75&w=1200&h=630&fit=crop&auto=format";
const shareImage = ogImage ?? defaultOgImage;

// Service names are free text in schema.org, so they follow the page language
// (unlike medicalSpecialty below, which is a fixed English enumeration).
const SERVICE_KEYS = ["svc.1", "svc.2", "svc.3", "svc.4", "svc.5", "svc.6", "svc.7"] as const;

const clinicJsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  "name": CLINIC.name,
  "alternateName": CLINIC.legalName,
  "url": CLINIC.url,
  "logo": `${site}/assets/logo.jpg`,
  "image": defaultOgImage,
  "telephone": CLINIC.telephone,
  "priceRange": CLINIC.priceRange,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": CLINIC.streetAddress,
    "addressLocality": CLINIC.addressLocality,
    "postalCode": CLINIC.postalCode,
    "addressRegion": CLINIC.addressRegion,
    "addressCountry": CLINIC.addressCountry
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": CLINIC.latitude,
    "longitude": CLINIC.longitude
  },
  "openingHoursSpecification": CLINIC.openingHours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": h.days,
    "opens": h.opens,
    "closes": h.closes
  })),
  // Only values from schema.org's MedicalSpecialty list are valid here ("Plastic Surgery" and "Hair Restoration" are not).
  "medicalSpecialty": ["https://schema.org/Dermatology", "https://schema.org/PlasticSurgery"],
  "availableService": SERVICE_KEYS.map((key) => t(locale, key)),
  "hasMap": CLINIC.googleMaps,
  "sameAs": CLINIC.sameAs
};

// Structured data must match the language of the page it is embedded in, so
// the FAQ schema is built from this locale's answers, not the English ones.
const localeFaq = faqFor(locale);
const faqJsonLd = includeFaqSchema
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "inLanguage": meta.hreflang,
      "mainEntity": [...localeFaq.inject, ...localeFaq.hair, ...localeFaq.surgery].map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  : null;
---

<!DOCTYPE html>
<html lang={meta.hreflang} dir={meta.dir}>
<head>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-5W3W32TS');</script>
  <!-- End Google Tag Manager -->

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Scroll-reveal styling only applies once JS is confirmed (html.js). Without JS, or if the page script never
       starts (js-fail after 6s), .reveal content stays visible instead of being stuck at opacity 0. -->
  <script is:inline>(function(d){d.classList.add('js');setTimeout(function(){if(!d.classList.contains('js-ready'))d.classList.add('js-fail')},6000)})(document.documentElement)</script>
  <title>{title}</title>
  <meta name="description" content={description} />
  {!omitCanonical && <link rel="canonical" href={canonicalUrl} />}

  {hreflangAlternates && alternateLocales.map((l) => (
    <link rel="alternate" hreflang={l.hreflang} href={`${site}${localePath(l.code, unprefixedPath)}`} />
  ))}
  {hreflangAlternates && xDefaultLocale && <link rel="alternate" hreflang="x-default" href={`${site}${localePath(xDefaultLocale, unprefixedPath)}`} />}

  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
  <meta name="author" content={CLINIC.name} />
  <meta name="theme-color" content="#1F1D1C" />

  <meta property="og:type" content="business.business" />
  <meta property="og:site_name" content={CLINIC.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={meta.hreflang.replace("-", "_")} />
  {hreflangAlternates && alternateLocales.filter((l) => l.code !== locale).map((l) => (
    <meta property="og:locale:alternate" content={l.hreflang.replace("-", "_")} />
  ))}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImage} />

  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta name="geo.region" content="DE-BE" />
  <meta name="geo.placename" content="Berlin" />
  <meta name="geo.position" content={`${CLINIC.latitude};${CLINIC.longitude}`} />
  <meta name="ICBM" content={`${CLINIC.latitude}, ${CLINIC.longitude}`} />

  <script type="application/ld+json" set:html={JSON.stringify(clinicJsonLd)} is:inline />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />}

  <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={playfairLatin} as="font" type="font/woff2" crossorigin />
  {locale === "ru" && <link rel="preload" href={playfairCyrillic} as="font" type="font/woff2" crossorigin />}
  {preloadItalic && <link rel="preload" href={locale === "ru" ? playfairItalicCyrillic : playfairItalicLatin} as="font" type="font/woff2" crossorigin />}
  <link rel="preconnect" href="https://images.unsplash.com" />
  <slot name="head" />
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5W3W32TS"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <a href="#main" class="skip-link">{t(locale, "skip.content")}</a>
  <slot />
</body>
</html>
